<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token|raw }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token|raw }}">
    <js-placeholder token="{{ placeholder_token|raw }}">
  </head>
  <body{{ attributes }}>
    {# 
      ¡OBLIGATORIO! page_top renderiza la barra de herramientas 
      del administrador de Drupal arriba del todo. 
    #}
    {{ page_top }}
    
    {# Aquí se renderiza todo el contenido de page.html.twig #}
    {{ page }}

    {# page_bottom maneja cierres de scripts del core #}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token|raw }}">
  </body>
</html>