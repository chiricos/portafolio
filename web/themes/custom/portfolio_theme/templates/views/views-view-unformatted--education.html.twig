{# templates/views/views-view-unformatted--experiencias.html.twig #}

{#
  @file
  Template para mostrar las experiencias laborales.
  #}

 <!-- Education-->
<section class="resume-section" id="education">
    <div class="resume-section-content">
        
        <h2 class="mb-5">{{ view.getTitle() }}</h2>
        
        {% for row in rows %}
          {% set fecha_inicio = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_start_date }}'] ?? '' %}
          {% set fecha_final = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_end_date }}'] ?? '' %}
            {% set node = row.content['#row']._entity %}
            {% if node %}
                <div class="d-flex flex-column flex-md-row justify-content-between mb-5">
                    <div class="flex-grow-1">
                        <h3 class="mb-0">{{ node.title.value }}</h3>
                        <div class="subheading mb-3">{{ node.field_desciption.value }}</div>
                        <p>{{ node.body.processed|raw }}</p>
                    </div>
                    <div class="flex-shrink-0"><span class="text-primary">{{ fecha_inicio }} - {{ fecha_final }}</span></div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</section>
<hr class="m-0" />

